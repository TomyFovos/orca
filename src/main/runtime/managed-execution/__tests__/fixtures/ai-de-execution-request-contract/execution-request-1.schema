{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-de.local/schemas/execution-request-1.schema.json",
  "title": "AI-DE Managed Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "request_id",
    "case_id",
    "task_id",
    "attempt_id",
    "packet_digest",
    "protocol_version",
    "schema_version",
    "issued_at",
    "expires_at",
    "operation_payload"
  ],
  "properties": {
    "schema": { "const": "ai-de.execution-request/1" },
    "operation": { "enum": ["prepare", "start", "stop", "cleanup"] },
    "request_id": { "$ref": "#/$defs/uuid" },
    "case_id": { "$ref": "#/$defs/caseId" },
    "task_id": { "$ref": "#/$defs/taskId" },
    "attempt_id": { "$ref": "#/$defs/taskId" },
    "packet_digest": { "$ref": "#/$defs/sha256" },
    "launch_plan_digest": {
      "oneOf": [ { "$ref": "#/$defs/sha256" }, { "type": "null" } ]
    },
    "protocol_version": { "const": "ai-de.protocol/1" },
    "schema_version": { "const": "execution-request-1" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "operation_payload": { "type": "object" }
  },
  "oneOf": [
    {
      "required": ["operation", "launch_plan_digest"],
      "properties": {
        "operation": { "const": "prepare" },
        "launch_plan_digest": { "const": null },
        "operation_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter"],
          "properties": {
            "adapter": { "enum": ["codex", "claude", "copilot", "opencode"] }
          }
        }
      }
    },
    {
      "required": ["operation", "launch_plan_digest"],
      "properties": {
        "operation": { "const": "start" },
        "launch_plan_digest": { "$ref": "#/$defs/sha256" },
        "operation_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "model", "write_permission", "prompt"],
          "properties": {
            "adapter": { "enum": ["codex", "claude", "copilot", "opencode"] },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adapter", "concrete_model_id"],
              "properties": {
                "adapter": { "enum": ["codex", "claude", "copilot", "opencode"] },
                "concrete_model_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^(?!cloud-|local-coder|local-coder-high|tool-only)"
                },
                "provider_id": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            },
            "write_permission": { "enum": ["read-only", "workspace-write"] },
            "prompt": { "type": "string", "maxLength": 262144 },
            "prompt_delivery": { "enum": ["auto-submit", "draft"] }
          }
        }
      }
    },
    {
      "required": ["operation", "launch_plan_digest"],
      "properties": {
        "operation": { "const": "stop" },
        "launch_plan_digest": { "$ref": "#/$defs/sha256" },
        "operation_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["graceful", "forced"] },
            "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
          }
        }
      }
    },
    {
      "required": ["operation", "launch_plan_digest"],
      "properties": {
        "operation": { "const": "cleanup" },
        "launch_plan_digest": {
          "oneOf": [ { "$ref": "#/$defs/sha256" }, { "type": "null" } ]
        },
        "operation_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verification_digest"],
          "properties": {
            "verification_digest": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
